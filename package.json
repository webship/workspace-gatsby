{
  "name": "@webship.co/workspace-gatsby",
  "version": "1.0.7",
  "description": "Gatsby for Webship Workspace: the builder (`cmd-gatsby-project.sh`) and the Gatsby CLI tool in every sites folder, a starter built to a production build and served in a container, the Gatsby step pack wired into the testing setup, and two AI agents in the AI Agents folder.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-gatsby.git"
  },
  "files": [
    "dist/src",
    "agents",
    "commands",
    "features",
    "scripts",
    "testing",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "gatsby",
    "label": "Gatsby",
    "needs": [
      [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "ai-agents"
    ],
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "files": [
        "commands/cmd-gatsby-project.sh",
        "commands/cmd-tools-gatsby-cli.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-gatsby.sh"
      ],
      "args": [
        "scripts/args/arg-gatsby.sh",
        "scripts/args/arg-gatsby-cli.sh"
      ],
      "machine": [
        "testing/site.feature"
      ]
    },
    "ai": {
      "agents": [
        "agents/gatsby-site-builder.md",
        "agents/gatsby-tester.md"
      ]
    },
    "features": [
      "features/gatsby.feature"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.7",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
