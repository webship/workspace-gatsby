{
  "name": "@webship.co/workspace-gatsby",
  "version": "1.0.11",
  "description": "Gatsby for Webship Workspace: the builder (`cmd-gatsby-project.sh`) and the Gatsby CLI tool in every sites folder, a starter built to a production build and served in a container, the Gatsby step pack wired into the testing setup, and its AI items in their folders: two agents, a skill, a command and a prompt.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-gatsby.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "docs",
    "features",
    "scripts",
    "testing",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "gatsby",
    "label": "Gatsby",
    "needs": [
      [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "files": [
        "commands/cmd-gatsby-project.sh",
        "commands/cmd-tools-gatsby-cli.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-gatsby.sh"
      ],
      "args": [
        "scripts/args/arg-gatsby.sh",
        "scripts/args/arg-gatsby-cli.sh"
      ],
      "machine": [
        "testing/site.feature"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/gatsby-site-builder.md",
        "ai/agents/gatsby-tester.md"
      ],
      "skills": [
        "ai/skills/gatsby-scenarios"
      ],
      "commands": [
        "ai/commands/gatsby-test.md"
      ],
      "prompts": [
        "ai/prompts/gatsby-build-and-test.md"
      ]
    },
    "features": [
      "features/gatsby.feature"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.7",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
